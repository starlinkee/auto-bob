# Copy to .env.local for local development. Production values live in Vercel.

# Public origin of the site, without trailing slash (canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business latitude, used for the map and structured data.
NEXT_PUBLIC_BUSINESS_LAT=

# Business longitude, used for the map and structured data.
NEXT_PUBLIC_BUSINESS_LNG=

# Optional. Google Maps API key; leave empty to use the keyless fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend API key used to send contact-form e-mails.
RESEND_API_KEY=

# Address that receives contact-form messages.
CONTACT_TO_EMAIL=

# Sender address; its domain must be verified in Resend.
CONTACT_FROM_EMAIL=

# Max contact submissions per client within the window (default 5).
CONTACT_RATE_LIMIT_MAX=5

# Rate-limit window in milliseconds (default 600000 = 10 minutes).
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# Tests only: enables test-only endpoints. Never set in production.
ENABLE_TEST_ENDPOINTS=
